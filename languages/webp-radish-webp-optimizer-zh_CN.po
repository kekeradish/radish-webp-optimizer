msgid "Radish WebP Optimizer"
msgstr "萝卜 WebP 大师"

msgid "🥕 Radish WebP Optimizer"
msgstr "🥕 萝卜 WebP 大师"

msgid "🥕 Radish WebP"
msgstr "🥕 萝卜 WebP"

msgid "Dual-stage optimization architecture for massive server storage savings and lightning-fast WebP loading."
msgstr "双重图片优化架构：原图智能瘦身 + WebP 终极优化，兼顾服务器磁盘与前台秒开速度。"

msgid "PHP Version:"
msgstr "PHP 版本:"

msgid "Driver:"
msgstr "图像驱动:"

msgid "Engine Active"
msgstr "引擎运行中"

msgid "None"
msgstr "未检测到支持库"

msgid "Bulk Optimization Workbench"
msgstr "批量图片优化工作台"

msgid "Scan and filter all media library images in an independent large modal dialog with large preview, selection, and dual-optimization."
msgstr "以独立大窗口形式直观扫描、筛选全站图片，支持高清大图预览、自定义勾选与实时双重优化。"

msgid "Open Bulk Optimization Workbench"
msgstr "打开批量优化管理大窗口"

msgid "No Horizontal Scroll"
msgstr "全屏宽阔视野"

msgid "Lightbox Large Preview"
msgstr "大图灯箱预览"

msgid "Batch Selection"
msgstr "精准批量选择"

msgid "Core Optimization Settings"
msgstr "双重优化核心配置"

msgid "Interface Language"
msgstr "界面显示语言"

msgid "Select the display language for the plugin settings and batch workbench."
msgstr "选择插件管理后台、弹窗工作台与操作提示的界面语言。"

msgid "Auto (Follow Site Language)"
msgstr "跟随站点默认语言 (Site Default)"

msgid "Simplified Chinese"
msgstr "简体中文"

msgid "English"
msgstr "英文"

msgid "Enable Plugin Features"
msgstr "启用插件功能"

msgid "Master switch. Disabling stops frontend replacement and automatic conversion."
msgstr "总开关。关闭后将停止前端替换与自动优化。"

msgid "Auto Convert on Upload"
msgstr "上传新图时自动优化"

msgid "Automatically optimize original images and generate WebP files upon uploading new JPG/PNG."
msgstr "上传 JPG/PNG 时，自动进行【原图自身瘦身】+【WebP 副本生成】。"

msgid "Original Slimming & Safe Backup"
msgstr "原图瘦身与安全备份"

msgid "Enable Original Image Slimming Optimization"
msgstr "开启原图自身瘦身优化"

msgid "Strip EXIF metadata and perform smart color quantization on JPG/PNG originals to drastically save server disk space!"
msgstr "对原 JPG/PNG 剥离 EXIF 元数据并进行 256 色智能色彩量化与高保真压缩，大幅节省服务器磁盘！"

msgid "Keep Initial Master Backup (.radish_bak)"
msgstr "保留原始母本备份 (安全备份)"

msgid "Preserve a .radish_bak backup before slimming. Enables one-click restoration in Media Library anytime."
msgstr "瘦身前保留一份 .radish_bak 原始备份文件。开启后可在媒体库随时一键【恢复最初原图】。"

msgid "Original Image Quality:"
msgstr "原图压缩质量:"

msgid "(Recommended: 82% ~ 85% for high visual fidelity)"
msgstr "(建议 82% ~ 85%，确保原图母本高保真)"

msgid "Max Original Resolution Dimension:"
msgstr "原图最大分辨率限制:"

msgid "WebP Conversion Quality"
msgstr "WebP 二次终极优化质量"

msgid "WebP quality delivered to website visitors. Recommended: 75% ~ 82% (sweet spot for size & quality)."
msgstr "前台访客加载的 WebP 质量。推荐 75% ~ 82%（肉眼几乎无损且体积最小）。"

msgid "Frontend Delivery Mode"
msgstr "前端输出与降级模式"

msgid "HTML5 <picture> Mode"
msgstr "HTML5 <picture> 模式"

msgid "Recommended"
msgstr "强烈推荐"

msgid "Modern browsers load WebP, legacy clients automatically fallback to original images. 100% zero broken images."
msgstr "现代浏览器加载超轻 WebP，老旧客户端自动加载瘦身后的原图，100% 零破图。"

msgid "Direct URL Replacement Mode"
msgstr "直接替换模式"

msgid "Directly replaces <img src="..."> image URLs with .webp URLs."
msgstr "直接将 <img src="..."> 替换为 WebP 格式 URL。"

